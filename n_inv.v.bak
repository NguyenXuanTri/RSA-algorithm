module n_inv #(
    parameter WIDTH = 1024
)(
    input               clk,
    input               reset,
    input               start,
    input  [WIDTH-1:0]  n,     
	 
    output reg [WIDTH-1:0] result,
    output reg          done
);

    reg [WIDTH-1:0] x, N;
    reg [3:0] i;
    reg [2*WIDTH-1:0] t; 
	 
    reg [2:0] state;
    localparam IDLE = 0,
               CALC_T  = 1,
               CALC_X = 2,
	       RESULT = 3,
               DONE = 4;

    always @(posedge clk or posedge reset) begin
        if (reset) begin
            done   <= 0;
            state  <= IDLE;
        end else begin
            case (state)

                IDLE: begin
                    done <= 0;
                    if (start) begin
                        N <= n;
			i <= 0;
			x <= n;
                        state <= CALC_T;
                    end
                end

                CALC_T: begin
                	t <= N * x;
						  
			state <= CALC_X;		  
                end

                CALC_X: begin
                	x <= x * (2 - t[WIDTH-1:0]);
                	result <= x;
						  
			i <= i + 1;
			if (i == 9) state <= RESULT;
			else state <= CALC_T;
                end
					 
		RESULT: begin
                	result <= ~x + 1;
			done <= 1;
			state <= DONE;
                end

		DONE: begin
			done <= 1;
			state <= IDLE;
                end

            endcase
        end
    end

endmodule